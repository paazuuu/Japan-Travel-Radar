APP_ENV=development

# PostgreSQL / PostGIS
POSTGRES_DB=japan_travel
POSTGRES_USER=travel
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://travel:CHANGE_ME@postgres:5432/japan_travel

# AI / Maps
AI_API_KEY=
# LLM model id for analysis/translation/summary (rules fallback if AI_API_KEY unset)
AI_MODEL=claude-opus-5
MAPS_API_KEY=

# Security
SECRET_KEY=CHANGE_ME
# Required to call /api/v1/admin/* (sent as X-Admin-Key header)
ADMIN_API_KEY=CHANGE_ME_ADMIN
# API rate limit per client IP per minute (0 disables)
RATE_LIMIT_PER_MIN=120

# URLs (used for CORS / inter-service calls)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Frontend -> Backend (browser side)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Collector: real data sources (MVP2 extension) ---
# Update job cadence (seconds). The collector container re-runs on this interval.
COLLECT_INTERVAL_SECONDS=86400
# Set COLLECTOR_DISABLE_NETWORK=1 to run only the offline fixture sources.
COLLECTOR_DISABLE_NETWORK=

# Preset-only datasets: paste 推奨データセット(観光施設一覧) CSV URLs, no mapping needed.
OPENDATA_PRESET_URLS=
OPENDATA_PRESET_FORMAT=csv
OPENDATA_PRESET_ENCODING=utf-8-sig
# OpenStreetMap Overpass endpoint (ODbL). Override to use a mirror if needed.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Wikidata SPARQL endpoint (CC0).
WIKIDATA_URL=https://query.wikidata.org/sparql
# Comma-separated RSS feed URLs (headline + link only).
RSS_FEEDS=
# YouTube Data API (official API only; no scraping). Leave blank to skip.
YOUTUBE_API_KEY=
YOUTUBE_QUERY=関西 旅行 観光
# Comma-separated open-data JSON array endpoints (our field convention).
OPENDATA_JSON_URLS=
# Configured municipal datasets with column mapping (CSV/JSON). Points at a
# JSON config; edit that file to add real datasets. See docs/DATA_SOURCES.md.
OPENDATA_CONFIG=
